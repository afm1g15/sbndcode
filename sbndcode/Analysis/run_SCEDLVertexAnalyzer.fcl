process_name: SCEDLVertexAnalyzer

source:
{
  module_type: RootInput
  maxEvents:   -1
}
services:
{
  ParticleInventoryService:  @local::standard_particleinventoryservice
  BackTrackerService:        @local::standard_backtrackerservice

  TFileService: { fileName: "sceanalysisOutput.root"}
  @table::sbnd_services
}

physics:
{
  analyzers:
  {
    ana: @local::analyzer_params
  }
  path0:   [ ana ]
  end_paths:  [ path0 ]
}

services.BackTrackerService.BackTracker.SimChannelModuleLabel: "simtpc2d:simpleSC"
physics.producers.pandora.EnableMCParticles: true
