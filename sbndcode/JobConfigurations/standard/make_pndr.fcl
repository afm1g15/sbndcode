physics.producers.pandora.ConfigFile: "PandoraSettings_Master_SBND.xml"
physics.producers.pandora.EnableMCParticles: true

services.SpaceCharge.EnableCalEfieldSCE: false
services.SpaceCharge.EnableCalSpatialSCE: false
